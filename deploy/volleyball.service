[Unit]
Description=TCJH Volleyball API Server
After=network.target

[Service]
# 獨立的系統帳號，與同主機上其他服務（ISIRL，跑在 felidae 帳號）隔開
User=volleyball
Group=volleyball
WorkingDirectory=/opt/volleyball
# 使用 venv 裡的 gunicorn，並綁定在內部的 5000 埠號
# 主機只有 1 核心，2 個 worker 就夠，多開只會多吃記憶體
# --preload：先在主程序載入一次 app（建表只跑一次），避免多個 worker 同時 create_all 撞在一起
# --no-control-socket：程式目錄是唯讀的，不建立 gunicorn.ctl
ExecStart=/opt/volleyball/venv/bin/gunicorn -w 2 --preload --no-control-socket -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5s

# 資源上限：就算記憶體洩漏也不會拖垮同主機上的其他服務
MemoryMax=300M

# 檔案系統隔離：整個系統唯讀，只有資料庫目錄可寫；/home 完全看不到
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/volleyball/instance

[Install]
WantedBy=multi-user.target
