[Unit]
Description=TCJH Volleyball API Server
After=network.target

[Service]
User=felidae
Group=www-data
WorkingDirectory=/opt/volleyball
# 使用 venv 裡的 gunicorn，並綁定在內部的 5000 埠號
ExecStart=/opt/volleyball/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
